#!/bin/sh
cd "$(git rev-parse --show-toplevel)" || exit 1

staged_files=$(git diff --cached --name-only --diff-filter=ACMR)

js_files=$(echo "$staged_files" | grep -E '\.(js|mjs|cjs)$')
md_files=$(echo "$staged_files" | grep -E '\.md$')
prettier_files=$(echo "$staged_files" | grep -E '\.(js|mjs|cjs|md|yaml|yml|json|css|html)$')

status=0

if [ -n "$js_files" ]; then
    echo "$js_files" | xargs npx eslint || status=1
fi

if [ -n "$md_files" ]; then
    echo "$md_files" | xargs npx markdownlint || status=1
fi

if [ -n "$prettier_files" ]; then
    echo "$prettier_files" | xargs npx prettier --check || status=1
fi

exit $status
