{% extends "./base.njk" %}

{% block content %}
<div class="stripe-content">
    <div class="project-content">
        <h2>{{ title }}</h2>
        {% if bandcampID and bandcampUrl or songLink or songs %}
            <div class="side-by-side">
                {% if bandcampID and bandcampUrl %}
                    <iframe style="border: 0; max-width: 400px; height: 470px;" src="https://bandcamp.com/EmbeddedPlayer/album={{ bandcampID }}/size=large/bgcol=ffffff/linkcol=0687f5/tracklist=false/transparent=true/" seamless><a href="https://emmaazelborn.bandcamp.com{{ bandcampUrl }}">{{ title }} by Emma Azelborn</a></iframe>
                {% endif %}
                <div >
                    {% if songLink %}
                        <a href="{{ songLink }}" class="button stream-button">Stream {{ title }}</a>
                    {% endif %}
                    {% if songs %}
                        <ol>
                            {% for song in songs %}
                            <li>
                                {% if song.lyricsUrl %}
                                <a href="{{ song.lyricsUrl }}">
                                    {{ song.title }}
                                </a>
                                {% else %}
                                {{ song.title }}
                                {% endif %}
                            </li>
                            {% endfor %}
                        </ol>
                    {% endif %}
                </div>
            </div>
        {% endif %}
        {% if description %}
            <p>{{ description | markdown | safe }}</p>
        {% endif %}
        {{ content | safe }}
        {% if calendarId %}
            {% set projectOneOff = calendarEvents.oneOff | eventsForCalendar(calendarId) %}
            {% set projectRecurring = calendarEvents.recurring | eventsForCalendar(calendarId) %}
            {% if projectOneOff.length or projectRecurring.length %}
                {% if projectOneOff.length %}
                <h3>Upcoming events</h3>
                <ul class="event-list event-list--project">
                    {% for event in projectOneOff %}
                        <li class="event-item event-item--{{ event.calendar }}">
                            <span class="event-calendar">{{ event.calendar | calendarDisplayName }}</span>
                            <time class="event-date" datetime="{{ event.start | date('yyyy-MM-dd') }}">
                                {{ event.start | dateEastern("date") }}{% if not event.isFullDay %}<br>{{ event.start | dateEastern("time") }}{% endif %}
                            </time>
                            <span class="event-title">{{ event.title }}</span>
                            {% if event.location %}
                                <a class="event-location" href="{{ event.location | googleMapsUrl }}" target="_blank" rel="noopener noreferrer">{{ event.location }}</a>
                            {% endif %}
                            {% if event.description %}
                                <div class="event-description-wrap event-description--truncated">
                                    <div class="event-description">{{ event.description | safe }}</div>
                                </div>
                                <button type="button" class="event-description-toggle" aria-expanded="false" aria-label="Expand description">···</button>
                            {% endif %}
                        </li>
                    {% endfor %}
                </ul>
                {% endif %}
                {% if projectRecurring.length %}
                <h3>Recurring events</h3>
                <p class="events-recurring-intro">Next occurrence below; see full calendar for all dates.</p>
                <ul class="events-recurring-list">
                    {% for event in projectRecurring %}
                    <li class="events-recurring-item">
                        <time class="event-date" datetime="{{ event.start | date('yyyy-MM-dd') }}">
                            {{ event.start | dateEastern("date") }}{% if not event.isFullDay %}<br>{{ event.start | dateEastern("time") }}{% endif %}
                        </time>
                        <div class="events-recurring-details">
                            <span class="events-recurring-frequency">{{ event.recurrenceLabel or 'Recurring' }}</span>
                            <span class="event-title">{{ event.title }}</span>
                            {% if event.location %}
                                <a class="event-location" href="{{ event.location | googleMapsUrl }}" target="_blank" rel="noopener noreferrer">{{ event.location }}</a>
                            {% endif %}
                            {% if event.description %}
                            <div class="event-description-wrap event-description--truncated">
                                <div class="event-description">{{ event.description | safe }}</div>
                            </div>
                            <button type="button" class="event-description-toggle" aria-expanded="false" aria-label="Expand description">···</button>
                            {% endif %}
                            <span class="events-recurring-links">
                                <a class="events-recurring-link" href="{{ event.calendarUrl }}" target="_blank" rel="noopener noreferrer">See full calendar</a>
                            </span>
                        </div>
                    </li>
                    {% endfor %}
                </ul>
                {% endif %}
                <p class="back-to-events">
                    <a href="/events/">All Events</a>
                </p>
            {% endif %}
        {% endif %}
    </div>
</div>
{% endblock %}
{% block secondary_content %}
    {% if credits %}
        <div class="credits">
            {{ credits | markdown | safe }}
        </div>
    {% endif %}
{% endblock %}