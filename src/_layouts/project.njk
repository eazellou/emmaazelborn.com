{% extends "./base.njk" %}

{% block content %}
<div class="stripe-content">
    <div class="project-content">
        <h2>{{ title }}</h2>
        {% if bandcampID and bandcampUrl or songLink or songs %}
            <div class="side-by-side">
                {% if bandcampID and bandcampUrl %}
                    <iframe style="border: 0; max-width: 400px; height: 470px;" src="https://bandcamp.com/EmbeddedPlayer/album={{ bandcampID }}/size=large/bgcol=ffffff/linkcol=0687f5/tracklist=false/transparent=true/" seamless><a href="https://emmaazelborn.bandcamp.com{{ bandcampUrl }}">{{ title }} by Emma Azelborn</a></iframe>
                {% endif %}
                <div >
                    {% if songLink %}
                        <a href="{{ songLink }}" class="button stream-button">Stream {{ title }}</a>
                    {% endif %}
                    {% if songs %}
                        <ol>
                            {% for song in songs %}
                            <li>
                                {% if song.lyricsUrl %}
                                <a href="{{ song.lyricsUrl }}">
                                    {{ song.title }}
                                </a>
                                {% else %}
                                {{ song.title }}
                                {% endif %}
                            </li>
                            {% endfor %}
                        </ol>
                    {% endif %}
                </div>
            </div>
        {% endif %}
        {% if description %}
            <p>{{ description | markdown | safe }}</p>
        {% endif %}
        {{ content | safe }}
        {% if calendarId %}
            {% set projectEvents = calendarEvents | eventsForCalendar(calendarId) %}
            {% if projectEvents.length %}
                <h3>Upcoming events</h3>
                <ul class="event-list event-list--project">
                    {% for event in projectEvents %}
                        <li class="event-item event-item--{{ event.calendar }}">
                            <span class="event-calendar">{{ event.calendar | calendarDisplayName }}</span>
                            <time class="event-date" datetime="{{ event.start | date('yyyy-MM-dd') }}">
                                {{ event.start | dateEastern("date") }}{% if not event.isFullDay %} at {{ event.start | dateEastern("time") }}{% endif %}
                            </time>
                            <span class="event-title">{{ event.title }}</span>
                            {% if event.location %}
                                <span class="event-location">{{ event.location }}</span>
                            {% endif %}
                            {% if event.description %}
                                {% if event.description.length > 250 %}
                                    <div class="event-description-wrap event-description--truncated">
                                        <div class="event-description">{{ event.description | safe }}</div>
                                    </div>
                                    <button type="button" class="event-description-toggle" aria-expanded="false">…</button>
                                {% else %}
                                    <div class="event-description">{{ event.description | safe }}</div>
                                {% endif %}
                            {% endif %}
                        </li>
                    {% endfor %}
                </ul>
                <p class="back-to-events">
                    <a href="/events/">All Events</a>
                </p>
            {% endif %}
        {% endif %}
    </div>
</div>
{% endblock %}
{% block secondary_content %}
    {% if credits %}
        <div class="credits">
            {{ credits | markdown | safe }}
        </div>
    {% endif %}
{% endblock %}