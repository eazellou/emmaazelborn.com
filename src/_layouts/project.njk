{% extends "./base.njk" %}

{% block content %}
<div class="stripe-content">
    <div class="project-content">
        <h2>{{ title }}</h2>
        {% if bandcampID and bandcampUrl or songLink or songs %}
            <div class="side-by-side">
                {% if bandcampID and bandcampUrl %}
                    <iframe style="border: 0; max-width: 400px; height: 470px;" src="https://bandcamp.com/EmbeddedPlayer/album={{ bandcampID }}/size=large/bgcol=ffffff/linkcol=0687f5/tracklist=false/transparent=true/" seamless><a href="https://emmaazelborn.bandcamp.com{{ bandcampUrl }}">{{ title }} by Emma Azelborn</a></iframe>
                {% endif %}
                <div >
                    {% if songLink %}
                        <a href="{{ songLink }}" class="button stream-button">Stream {{ title }}</a>
                    {% endif %}
                    {% if songs %}
                        <ol>
                            {% for song in songs %}
                            <li>
                                {% if song.lyricsUrl %}
                                <a href="{{ song.lyricsUrl }}">
                                    {{ song.title }}
                                </a>
                                {% else %}
                                {{ song.title }}
                                {% endif %}
                            </li>
                            {% endfor %}
                        </ol>
                    {% endif %}
                </div>
            </div>
        {% endif %}
        {% if description %}
            <p>{{ description | markdown | safe }}</p>
        {% endif %}
        {{ content | safe }}
        {% if calendarId %}
            {% set projectOneOff = calendarEvents.oneOff | eventsForCalendar(calendarId) %}
            {% set projectRecurring = calendarEvents.recurring | eventsForCalendar(calendarId) %}
            {% if projectOneOff.length or projectRecurring.length %}
                {% if projectOneOff.length %}
                <h3>Upcoming events</h3>
                {% set calendarEvents = projectOneOff %}
                {% set design = 'cards' %}
                {% include "includes/events-list.njk" %}
                {% endif %}
                {% if projectRecurring.length %}
                <h3>Recurring events</h3>
                <p class="events-recurring-intro">Next occurrence below; see full calendar for all dates.</p>
                {% set recurringEvents = projectRecurring %}
                {% include "includes/events-recurring-list.njk" %}
                {% endif %}
                <p class="back-to-events">
                    <a href="/events/">All Events</a>
                </p>
            {% endif %}
        {% endif %}
    </div>
</div>
{% endblock %}
{% block secondary_content %}
    {% if credits %}
        <div class="credits">
            {{ credits | markdown | safe }}
        </div>
    {% endif %}
{% endblock %}