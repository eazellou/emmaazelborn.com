{% extends "./base.njk" %}

{% block content %}
    <div class="stripe-content">
        <p class="back-to-songs">
            <a href="/songs/">« All Songs</a>
        </p>
        <h2>{{ title }}</h2>
        {% if released %}
        <div class="song-projects">
            <strong>Appears in:</strong>
            <ul>
            {% for project in released %}
                <li><a href="/projects/{{ project }}/">{{ project | replace('-', ' ') | title }}</a></li>
            {% endfor %}
            </ul>
        </div>
        {% else %}
        <p><em>This song is not released yet, but I've been singing it out in the world. Feel free to learn it and sing it with your friends!</em></p>
        {% endif %}
        <div class="song-lyrics">
            {{ content | safe }}
        </div>
        {% if bandcampTrackId %}
            {% set project = collections.projects | getProjectByName(released[0]) %}
            <iframe style="border: 0; width: 250px; height: 250px;" src="https://bandcamp.com/EmbeddedPlayer/album={{ project.bandcampID }}/size=large/bgcol=ffffff/linkcol=0687f5/minimal=true/track={{ bandcampTrackId }}/transparent=true/" seamless><a href="https://emmaazelborn.bandcamp.com{{ project.bandcampUrl }}">{{ title }} by Emma Azelborn</a></iframe>
        {% endif %}
    </div>
{% endblock %}