{% extends "base.njk" %}

{% block content %}
    <div class="stripe-content">
        <h2 class="page-title">{{ title }}</h2>
        {% set oneOffEvents = calendarEvents.oneOff %}
        {% set recurringEvents = calendarEvents.recurring %}
        {% set calendarEvents = oneOffEvents %}
        {% set design = 'cards' %}
        {% include "includes/events-list.njk" %}
        {% if recurringEvents.length %}
        <section class="events-recurring-section" aria-labelledby="recurring-heading">
            <h3 id="recurring-heading" class="events-recurring-heading">Recurring events</h3>
            <ul class="event-list event-list--cards">
                {% for event in recurringEvents %}
                <li class="event-item event-item--recurring">
                    <time class="event-date" datetime="{{ event.start | date('yyyy-MM-dd') }}">
                        {{ event.start | dateEastern("date") }}{% if not event.isFullDay %}<br>{{ event.start | dateEastern("time") }}{% endif %}
                    </time>
                    <span class="event-title-line"><span class="event-recurring-label">{{ event.recurrenceLabel or 'Recurring' }}</span> <span class="event-title">{{ event.title }}</span></span>
                    {% if event.location %}
                        <a class="event-location" href="{{ event.location | googleMapsUrl }}" target="_blank" rel="noopener noreferrer">{{ event.location }}</a>
                    {% endif %}
                    {% if event.description %}
                    <div class="event-description-wrap event-description--truncated">
                        <div class="event-description">{{ event.description | safe }}</div>
                    </div>
                    <button type="button" class="event-description-toggle" aria-expanded="false" aria-label="Expand description">∨</button>
                    {% endif %}
                    <span class="event-links">
                        {% if event.linkText %}
                        <a class="event-link" href="{{ event.linkUrl }}">{{ event.linkText }}</a>
                        <span class="event-link-sep">·</span>
                        {% endif %}
                        <a class="event-link" href="{{ event.calendarUrl }}" target="_blank" rel="noopener noreferrer">See full calendar</a>
                    </span>
                </li>
                {% endfor %}
            </ul>
        </section>
        {% endif %}
        <p class="events-subscribe">
            Add to your calendar:
            {% for cal in calendars %}
            <a href="{{ cal.webUrl }}" target="_blank" rel="noopener noreferrer">{{ cal.displayName }}</a>{% if not loop.last %}, {% endif %}
            {% endfor %}
        </p>
        {{ content | safe }}
    </div>
{% endblock %}
